#!/usr/bin/env bash
set -euo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
data_root="$(meeting_data_root)"

open_transcript=1
copy_prompt=1
offer_names=1
diarize=1
speaker_count=""
input=""
meetings_root="$data_root"
transcribe_arguments=()
local_provider=0
assemblyai_override=""

usage() {
  printf '%s\n' \
    'Usage: meeting process [options] [INPUT]' \
    '' \
    'Runs the complete post-meeting workflow for INPUT, or for the newest' \
    'completed recording when INPUT is omitted.' \
    '' \
    'Options:' \
    '  --speakers N          Use an exact speaker count' \
    '  --local               Use the local MLX/Community-1 fallback' \
    '  --backend ENGINE      Local engine: mlx or whisperx (CPU fallback)' \
    '  --model MODEL         Local Whisper model (default: turbo)' \
    '  --hotwords TEXT       Bias local recognition vocabulary' \
    '  --no-diarize          Use local transcription without diarization' \
    '  --skip-names          Keep anonymous speaker labels' \
    '  --no-open             Do not open the HTML transcript' \
    '  --no-copy             Print rather than copy the Codex prompt' \
    '  --meetings-root DIR  Search DIR when INPUT is omitted' \
    '  --output-root DIR     Advanced: write transcript runs directly under DIR' \
    '  -h, --help            Show this help'
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --speakers)
      [[ $# -ge 2 ]] || fail '--speakers requires a positive integer'
      speaker_count="$2"
      transcribe_arguments+=(--speakers "$2")
      shift 2
      ;;
    --backend|--model|--hotwords|--output-root)
      [[ $# -ge 2 ]] || fail "$1 requires a value"
      transcribe_arguments+=("$1" "$2")
      if [[ "$1" != "--output-root" ]]; then
        local_provider=1
      fi
      shift 2
      ;;
    --meetings-root|--recordings-root)
      [[ $# -ge 2 ]] || fail "$1 requires a value"
      meetings_root="$2"
      shift 2
      ;;
    --no-diarize)
      diarize=0
      local_provider=1
      transcribe_arguments+=(--no-diarize)
      shift
      ;;
    --local)
      local_provider=1
      transcribe_arguments+=(--local)
      shift
      ;;
    --skip-names)
      offer_names=0
      shift
      ;;
    --no-open)
      open_transcript=0
      shift
      ;;
    --no-copy)
      copy_prompt=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      [[ -z "$input" ]] || fail 'provide at most one input file'
      input="$1"
      shift
      ;;
  esac
done

assemblyai_override="${ASSEMBLYAI_API_KEY:-}"
unset ASSEMBLYAI_API_KEY

if [[ -z "$input" ]]; then
  input="$(meeting_latest_recording "$meetings_root" || true)"
  [[ -n "$input" ]] || fail "no completed meeting recording found in: $meetings_root"
  printf 'Selected recording: %s\n' "$input"
  if [[ -t 0 ]]; then
    printf 'Process this recording? [Y/n] '
    read -r recording_reply || true
    case "${recording_reply:-y}" in
      y|Y|yes|YES) ;;
      *) printf 'Cancelled.\n'; exit 0 ;;
    esac
  fi
else
  [[ -f "$input" && -r "$input" ]] || fail "input is not a readable file: $input"
  printf 'Recording: %s\n' "$input"
fi

if [[ "$diarize" -eq 1 && -z "$speaker_count" && -t 0 ]]; then
  printf 'Known speaker count (leave blank to estimate): '
  read -r speaker_count || true
  if [[ -n "$speaker_count" ]]; then
    [[ "$speaker_count" =~ ^[1-9][0-9]*$ ]] || fail 'speaker count must be a positive integer'
    transcribe_arguments+=(--speakers "$speaker_count")
  fi
fi

result_file="$(mktemp "${TMPDIR:-/tmp}/meeting-process.XXXXXX")"
cleanup() {
  rm -f "$result_file"
}
trap cleanup EXIT

if [[ "${#transcribe_arguments[@]}" -gt 0 ]]; then
  invocation=("${utility_root}/bin/meeting-transcribe" "${transcribe_arguments[@]}" "$input")
else
  invocation=("${utility_root}/bin/meeting-transcribe" "$input")
fi

if [[ "$local_provider" -eq 1 ]]; then
  printf '\nProvider: local (recording stays on this Mac)\n'
else
  printf '\nProvider: AssemblyAI (recording will leave this Mac)\n'
fi
printf 'Transcribing…\n'
if [[ "$local_provider" -eq 0 && -n "$assemblyai_override" ]]; then
  ASSEMBLYAI_API_KEY="$assemblyai_override" \
    MEETING_DATA_DIR="$meetings_root" \
    MEETING_TRANSCRIBER_RESULT_FILE="$result_file" "${invocation[@]}"
else
  MEETING_DATA_DIR="$meetings_root" \
    MEETING_TRANSCRIBER_RESULT_FILE="$result_file" "${invocation[@]}"
fi
unset assemblyai_override
output_dir="$(sed -n '1p' "$result_file")"
[[ -n "$output_dir" && -d "$output_dir" ]] || fail 'transcription completed without reporting its output directory'

json_path="${output_dir}/transcript.json"
[[ -f "$json_path" ]] || fail "canonical transcript JSON is missing: $json_path"

if [[ "$diarize" -eq 1 && "$offer_names" -eq 1 ]]; then
  if [[ -t 0 ]]; then
    printf '\nName the detected speakers now? [Y/n] '
    read -r name_reply || true
    case "${name_reply:-y}" in
      y|Y|yes|YES)
        "${utility_root}/bin/name-latest-speakers" --json "$json_path" --no-open
        ;;
      *)
        printf 'Keeping anonymous speaker labels. Run meeting speakers later to add names.\n'
        ;;
    esac
  else
    printf 'Speaker naming skipped because input is non-interactive.\n'
  fi
fi

printf '\nPreparing the agent transcript…\n'
if [[ "$copy_prompt" -eq 0 ]]; then
  "${utility_root}/bin/meeting-prepare" --no-copy "$json_path"
else
  "${utility_root}/bin/meeting-prepare" "$json_path"
fi

if [[ "$open_transcript" -eq 1 ]]; then
  "${utility_root}/bin/view-latest-transcript" --json "$json_path"
fi

meeting_notify "Transcript ready: $(basename "$output_dir")"
printf '\nDone. Transcript bundle: %s\n' "$output_dir"
