#!/usr/bin/env bash
set -euo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
data_root="$(meeting_data_root)"
meetings_root="$data_root"
output_root=""
diarize=1
speakers=""
backend="mlx"
model="turbo"
hotwords=""
local_provider=0

usage() {
  printf '%s\n' \
    'Usage: transcribe-latest-meeting [--local] [--speakers N] [--backend ENGINE]' \
    '                                 [--model MODEL]' \
    '                                 [--hotwords TEXT] [--no-diarize]' \
    '                                 [--meetings-root DIR]' \
    '                                 [--output-root DIR]'
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --speakers)
      [[ $# -ge 2 ]] || fail '--speakers requires a positive integer'
      speakers="$2"
      shift 2
      ;;
    --model)
      [[ $# -ge 2 ]] || fail '--model requires a value'
      model="$2"
      local_provider=1
      shift 2
      ;;
    --backend)
      [[ $# -ge 2 ]] || fail '--backend requires mlx or whisperx'
      backend="$2"
      local_provider=1
      shift 2
      ;;
    --hotwords)
      [[ $# -ge 2 ]] || fail '--hotwords requires a value'
      hotwords="$2"
      local_provider=1
      shift 2
      ;;
    --no-diarize)
      diarize=0
      local_provider=1
      shift
      ;;
    --local)
      local_provider=1
      shift
      ;;
    --meetings-root|--recordings-root)
      [[ $# -ge 2 ]] || fail "$1 requires a value"
      meetings_root="$2"
      shift 2
      ;;
    --output-root)
      [[ $# -ge 2 ]] || fail '--output-root requires a value'
      output_root="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

[[ -z "$speakers" || "$speakers" =~ ^[1-9][0-9]*$ ]] || fail '--speakers requires a positive integer'
[[ -z "$speakers" || "$diarize" -eq 1 ]] || fail '--speakers may not be used with --no-diarize'
[[ "$backend" == "mlx" || "$backend" == "whisperx" ]] || fail '--backend requires mlx or whisperx'
latest_file="$(meeting_latest_recording "$meetings_root" || true)"
[[ -n "$latest_file" ]] || fail "no completed meeting recording found in: $meetings_root"

arguments=()
if [[ "$local_provider" -eq 1 ]]; then
  arguments=(--local --backend "$backend" --model "$model")
  if [[ -n "$hotwords" ]]; then
    arguments+=(--hotwords "$hotwords")
  fi
  if [[ "$diarize" -eq 1 ]]; then
    arguments+=(--diarize)
  fi
fi
if [[ -n "$speakers" ]]; then
  arguments+=(--speakers "$speakers")
fi

printf 'Latest recording: %s\n' "$latest_file"
if [[ -z "$output_root" ]]; then
  output_root="$(dirname "$latest_file")/transcripts"
fi
if [[ "${#arguments[@]}" -gt 0 ]]; then
  exec "${utility_root}/bin/transcribe-meeting" "${arguments[@]}" "$latest_file" "$output_root"
else
  exec "${utility_root}/bin/transcribe-meeting" "$latest_file" "$output_root"
fi
