#!/usr/bin/env bash
set -euo pipefail
umask 077

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
source "${utility_root}/lib/format.sh"
meetings_root="$(meeting_data_root)"
audio_device="${MEETING_RECORDING_DEVICE:-$(meeting_config_get recording_device 0)}"
capture_input="${MEETING_TRANSCRIBER_CAPTURE_INPUT:-}"

usage() {
  printf '%s\n' \
    'Usage: meeting record [--device NAME_OR_INDEX] [LABEL]' \
    '' \
    'Records the Mac microphone into a private dated meeting bundle until you' \
    'press q. A failed capture remains recording.partial.wav.' \
    '' \
    'Options:' \
    '  --device NAME_OR_INDEX  Use this microphone for this capture only' \
    '  -h, --help              Show this help'
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

migration_error() {
  printf '%s\n' "$1" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --device)
      [[ $# -ge 2 ]] || fail '--device requires a value'
      audio_device="$2"
      shift 2
      ;;
    --output-root)
      migration_error '`--output-root` was removed; recordings always live under the private meeting folder.'
      ;;
    --dry-run)
      migration_error '`--dry-run` was removed; run `meeting doctor` to check recording readiness.'
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -le 1 ]] || { usage >&2; exit 2; }
label="${1:-meeting}"
label_slug="$(printf '%s' "$label" | LC_ALL=C sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
[[ -n "$label_slug" ]] || label_slug="meeting"

ffmpeg_prefix="$(brew --prefix ffmpeg@7 2>/dev/null)" || fail 'Homebrew ffmpeg@7 is not installed'
ffmpeg_bin="${ffmpeg_prefix}/bin/ffmpeg"
ffprobe_bin="${ffmpeg_prefix}/bin/ffprobe"
[[ -x "$ffmpeg_bin" && -x "$ffprobe_bin" ]] || fail 'ffmpeg@7 is incomplete'

audio_device_name="$audio_device"
if [[ -z "$capture_input" && "$audio_device" =~ ^[0-9]+$ ]]; then
  device_listing="$("$ffmpeg_bin" -hide_banner -f avfoundation \
    -list_devices true -i '' 2>&1 || true)"
  resolved_device_name="$(printf '%s\n' "$device_listing" | awk -v device="$audio_device" '
    /AVFoundation audio devices:/ { in_audio = 1; next }
    in_audio && match($0, "\\[" device "\\] ") {
      sub(/^.*\[[0-9]+\] /, "")
      print
      exit
    }
  ')"
  [[ -z "$resolved_device_name" ]] || audio_device_name="$resolved_device_name"
fi

status_python="${utility_root}/.venv/bin/python"
status_renderer="${utility_root}/lib/recording_status.py"
interactive_status=0
if [[ -t 0 && -t 2 && -x "$status_python" && -f "$status_renderer" ]]; then
  interactive_status=1
fi

mkdir -p "$meetings_root"
[[ -d "$meetings_root" && -w "$meetings_root" ]] || fail "meeting directory is not writable: $meetings_root"
meetings_root="$(cd "$meetings_root" && pwd)"

stamp="$(date '+%Y%m%d-%H%M%S')"
bundle_dir="${meetings_root}/${stamp}-${label_slug}"
final_path="${bundle_dir}/recording.wav"
partial_path="${bundle_dir}/recording.partial.wav"
[[ ! -e "$bundle_dir" ]] || fail "dated meeting bundle already exists: $bundle_dir"
mkdir "$bundle_dir"

format_duration() {
  local total="$1"
  local hours minutes seconds
  hours=$((total / 3600))
  minutes=$(((total % 3600) / 60))
  seconds=$((total % 60))
  if [[ "$hours" -gt 0 ]]; then
    printf '%d:%02d:%02d' "$hours" "$minutes" "$seconds"
  else
    printf '%02d:%02d' "$minutes" "$seconds"
  fi
}

# Atomically expose the finalized capture to an embedding menu, when asked.
write_record_result() {
  local outcome="$1"
  [[ -n "${MEETING_TRANSCRIBER_RECORD_RESULT_FILE:-}" ]] || return 0
  local escaped_path temporary_result
  escaped_path="${final_path//\\/\\\\}"
  escaped_path="${escaped_path//\"/\\\"}"
  temporary_result="$(mktemp "${MEETING_TRANSCRIBER_RECORD_RESULT_FILE}.XXXXXX")"
  printf '{"recording":"%s","outcome":"%s"}\n' "$escaped_path" "$outcome" \
    > "$temporary_result"
  mv "$temporary_result" "$MEETING_TRANSCRIBER_RECORD_RESULT_FILE"
}

ui_title
ui_heading 'Recording'
ui_row 'File' "$(ui_display_path "$final_path")"
ui_row 'Microphone' "$audio_device_name"
if [[ -t 0 ]]; then
  ui_row 'Control' 'Press q to stop'
fi
printf '\n' >&2

command=(
  /usr/bin/caffeinate
  -i
  "$ffmpeg_bin"
  -hide_banner
  -loglevel warning
  -thread_queue_size 1024
)
if [[ -n "$capture_input" ]]; then
  command+=(-re -f lavfi -i "$capture_input")
else
  command+=(-f avfoundation -i ":${audio_device}")
fi
command+=(-vn)
if [[ "$interactive_status" -eq 1 ]]; then
  command+=(
    -af
    'astats=metadata=1:reset=1,ametadata=print:key=lavfi.astats.Overall.Peak_level:file=-:direct=1'
  )
fi
command+=(
  -ac 1
  -ar 48000
  -c:a pcm_s16le
  -n
  "$partial_path"
)

interrupted=0
trap 'interrupted=1' INT TERM
set +e
if [[ "$interactive_status" -eq 1 ]]; then
  "${command[@]}" | "$status_python" "$status_renderer" \
    --microphone "$audio_device_name" >&2
  pipeline_status=("${PIPESTATUS[@]}")
  capture_status="${pipeline_status[0]}"
else
  "${command[@]}"
  capture_status=$?
fi
set -e
trap - INT TERM

if [[ -s "$partial_path" ]] && duration_seconds="$("$ffprobe_bin" -v error \
  -show_entries format=duration \
  -of default=noprint_wrappers=1:nokey=1 "$partial_path" 2>/dev/null)"; then
  mv "$partial_path" "$final_path"
  duration_display=""
  duration_whole="${duration_seconds%%.*}"
  if [[ "$duration_whole" =~ ^[0-9]+$ ]]; then
    duration_display="$(format_duration "$duration_whole")"
  fi
  outcome="stopped"
  if [[ "$capture_status" -ne 0 || "$interrupted" -eq 1 ]]; then
    outcome="interrupted"
  fi
  ui_heading 'Recording saved'
  if [[ -n "$duration_display" ]]; then
    ui_row 'Duration' "$duration_display"
  fi
  ui_row 'File' "$(ui_display_path "$final_path")"
  if [[ "$outcome" == "interrupted" ]]; then
    ui_line 'Capture was interrupted, but the audio container finalized successfully.'
  fi
  ui_heading 'Next'
  ui_line 'meeting transcribe'
  write_record_result "$outcome"
  exit 0
fi

printf 'Error: recording did not finalize; inspect the partial file: %s\n' "$partial_path" >&2
exit 1
