#!/usr/bin/env bash
set -euo pipefail
umask 077

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
data_root="$(meeting_data_root)"
meetings_root="$data_root"
copy_prompt=1
json_path=""

usage() {
  printf '%s\n' \
    'Usage: meeting-prepare [--meetings-root DIR] [--no-copy] [JSON]' \
    '' \
    'Creates an agent-friendly Markdown transcript from JSON. When JSON is' \
    'omitted, the newest transcript is used. By default, a ready-to-paste' \
    'Codex prompt is copied to the clipboard.'
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --meetings-root|--transcripts-root)
      [[ $# -ge 2 ]] || fail 'option requires a directory'
      meetings_root="$2"
      shift 2
      ;;
    --no-copy)
      copy_prompt=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      [[ -z "$json_path" ]] || fail 'provide at most one JSON transcript'
      json_path="$1"
      shift
      ;;
  esac
done

if [[ -z "$json_path" ]]; then
  json_path="$(meeting_latest_transcript "$meetings_root" || true)"
fi

[[ -n "$json_path" && -f "$json_path" ]] || fail 'no JSON transcript was found'
markdown_path="${json_path%.json}.agent.md"
"${utility_root}/bin/render-transcript-markdown" "$json_path" "$markdown_path" >/dev/null

prompt="$(printf 'Use $meeting to digest the local transcript at: %s' "$markdown_path")"

printf 'Agent transcript: %s\n' "$markdown_path"
if [[ "$copy_prompt" -eq 1 ]]; then
  command -v pbcopy >/dev/null 2>&1 || fail 'pbcopy is unavailable; rerun with --no-copy'
  printf '%s' "$prompt" | pbcopy
  printf 'Codex prompt copied to the clipboard.\n'
else
  printf '\n%s\n' "$prompt"
fi
