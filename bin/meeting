#!/usr/bin/env bash
set -euo pipefail

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"

run_provider_command() {
  if [[ -n "$meeting_inherited_assemblyai_key" ]]; then
    ASSEMBLYAI_API_KEY="$meeting_inherited_assemblyai_key" exec "$@"
  fi
  exec "$@"
}

run_doctor_command() {
  if [[ -n "$meeting_inherited_assemblyai_key" ]]; then
    MEETING_TRANSCRIBER_KEY_OVERRIDE_PRESENT=1 exec "$@"
  fi
  exec "$@"
}

usage() {
  printf '%s\n' \
    'Meeting Transcriber' \
    '' \
    '  meeting record [LABEL]              Record until q is pressed' \
    '  meeting transcribe [INPUT]          Transcribe a recording with AssemblyAI' \
    '  meeting open                        Open the latest transcript' \
    '  meeting speakers [TRANSCRIPT_JSON]  Name or correct speakers' \
    '  meeting folder                      Open the meeting folder in Finder' \
    '  meeting setup                       Configure this Mac' \
    '  meeting doctor                      Check recording and transcription readiness' \
    '  meeting help                        Show this help' \
    '' \
    'Recovery:' \
    '  meeting cleanup [TRANSCRIPT_JSON]   Confirm remote deletion for a saved transcript' \
    '' \
    'Run a command with --help for its options.'
}

migration_error() {
  printf '%s\n' "$1" >&2
  exit 2
}

menu_record() {
  local label result_file record_status outcome recording python_bin reply
  printf 'Meeting label (optional): ' >&2
  read -r label || label=''
  result_file="$(mktemp "${TMPDIR:-/tmp}/meeting-record-result.XXXXXX")"
  record_status=0
  set +e
  if [[ -n "$label" ]]; then
    MEETING_TRANSCRIBER_RECORD_RESULT_FILE="$result_file" \
      "${utility_root}/bin/record-meeting" "$label"
  else
    MEETING_TRANSCRIBER_RECORD_RESULT_FILE="$result_file" \
      "${utility_root}/bin/record-meeting"
  fi
  record_status=$?
  set -e
  if [[ "$record_status" -ne 0 || ! -s "$result_file" ]]; then
    rm -f "$result_file"
    return 0
  fi
  python_bin="$(meeting_python_bin)"
  outcome="$("$python_bin" -c \
    'import json,sys; print(json.load(open(sys.argv[1])).get("outcome",""))' \
    "$result_file" 2>/dev/null || true)"
  recording="$("$python_bin" -c \
    'import json,sys; print(json.load(open(sys.argv[1])).get("recording",""))' \
    "$result_file" 2>/dev/null || true)"
  rm -f "$result_file"
  if [[ "$outcome" == "stopped" && -n "$recording" ]]; then
    printf 'Transcribe this recording now? [Y/n] ' >&2
    read -r reply || reply='n'
    case "${reply:-y}" in
      y|Y|yes|YES) run_provider_command "${utility_root}/bin/meeting-transcribe" "$recording" ;;
      *) printf 'Saved. Run meeting transcribe when you are ready.\n' >&2 ;;
    esac
  elif [[ -n "$recording" ]]; then
    printf 'Recording saved after interruption: %s\n' "$recording" >&2
  fi
  return 0
}

interactive_menu() {
  local choice
  while true; do
    printf '%s\n' \
      'Meeting Transcriber' \
      '' \
      'What would you like to do?' \
      '  1  Record a meeting' \
      '  2  Transcribe the latest recording' \
      '  3  Open the latest transcript' \
      '  4  Name or correct speakers' \
      '  5  Open the meeting folder' \
      '  6  Check setup' \
      '  7  Exit' \
      '' >&2
    printf 'Choose an option 1-7 [7]: ' >&2
    read -r choice || choice=7
    case "${choice:-7}" in
      1) menu_record ;;
      2) run_provider_command "${utility_root}/bin/meeting-transcribe" ;;
      3) exec "${utility_root}/bin/meeting-open" ;;
      4) exec "${utility_root}/bin/meeting-speakers" ;;
      5) exec "${utility_root}/bin/meeting-folder" ;;
      6) run_doctor_command "${utility_root}/bin/meeting-doctor" ;;
      7) exit 0 ;;
      *) printf 'Unknown option: %s\n\n' "$choice" >&2 ;;
    esac
  done
}

if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    interactive_menu
  else
    usage
  fi
  exit 0
fi

subcommand="$1"
shift
case "$subcommand" in
  record) exec "${utility_root}/bin/record-meeting" "$@" ;;
  transcribe) run_provider_command "${utility_root}/bin/meeting-transcribe" "$@" ;;
  open) exec "${utility_root}/bin/meeting-open" "$@" ;;
  speakers) exec "${utility_root}/bin/meeting-speakers" "$@" ;;
  folder) exec "${utility_root}/bin/meeting-folder" "$@" ;;
  setup) exec "${utility_root}/bin/meeting-setup" "$@" ;;
  doctor) run_doctor_command "${utility_root}/bin/meeting-doctor" "$@" ;;
  cleanup) run_provider_command "${utility_root}/bin/meeting-cleanup" "$@" ;;
  help|-h|--help)
    [[ $# -eq 0 ]] || { printf 'Error: meeting help accepts no arguments\n' >&2; exit 2; }
    usage
    ;;
  process)
    migration_error '`meeting process` was replaced by `meeting transcribe`.'
    ;;
  prepare)
    migration_error '`meeting prepare` is no longer needed; every transcript now includes transcript.md.'
    ;;
  verify)
    migration_error '`meeting verify` was removed; development checks live in the repository test suite.'
    ;;
  start)
    migration_error '`meeting start` was removed; use `meeting record`.'
    ;;
  view)
    migration_error '`meeting view` was removed; use `meeting open`.'
    ;;
  files)
    migration_error '`meeting files` was removed; use `meeting folder`.'
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$subcommand" >&2
    usage >&2
    exit 2
    ;;
esac
