#!/usr/bin/env bash
set -euo pipefail
umask 077

meeting_entry_assemblyai_key="${ASSEMBLYAI_API_KEY:-}"
unset ASSEMBLYAI_API_KEY

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
source "${utility_root}/lib/format.sh"
python_bin="${utility_root}/.venv/bin/python"
speakers=""

usage() {
  printf '%s\n' 'Usage: transcribe-meeting [--speakers N] INPUT OUTPUT_ROOT'
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

input=""

# One local preflight/setup failure block: what stopped, source safety, the
# not-applicable remote state, and exactly one recovery.
setup_problem() {
  local problem="$1"
  local fix_label="$2"
  local fix="$3"
  ui_heading 'Setup problem'
  ui_row 'Problem' "$problem"
  if [[ -n "$input" ]]; then
    ui_row 'Recording' "safe at ${input}"
  fi
  ui_line 'No audio left this Mac'
  ui_row "$fix_label" "$fix"
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --speakers)
      [[ $# -ge 2 ]] || fail '--speakers requires a positive integer'
      speakers="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -eq 2 ]] || { usage >&2; exit 2; }
input="$1"
output_root="$2"

[[ -f "$input" && -r "$input" ]] || fail "input is not a readable file: $input"
[[ -z "$speakers" || "$speakers" =~ ^[1-9][0-9]*$ ]] || fail '--speakers requires a positive integer'

command=("$python_bin" "${utility_root}/lib/transcription_cli.py" run "$input" "$output_root")
if [[ -n "$speakers" ]]; then
  command+=(--speakers "$speakers")
fi
if [[ -n "$meeting_inherited_assemblyai_key" ]]; then
  ASSEMBLYAI_API_KEY="$meeting_inherited_assemblyai_key" "${command[@]}"
else
  "${command[@]}"
fi
