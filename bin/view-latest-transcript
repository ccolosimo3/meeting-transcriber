#!/usr/bin/env bash
set -euo pipefail
umask 077

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
data_root="$(meeting_data_root)"
meetings_root="$data_root"
open_browser=1
json_path=""

usage() {
  printf '%s\n' 'Usage: meeting-view [--json FILE] [--meetings-root DIR] [--no-open]'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)
      [[ $# -ge 2 ]] || { printf 'Error: --json requires a value\n' >&2; exit 2; }
      json_path="$2"
      shift 2
      ;;
    --meetings-root|--transcripts-root)
      [[ $# -ge 2 ]] || { printf 'Error: option requires a directory\n' >&2; exit 2; }
      meetings_root="$2"
      shift 2
      ;;
    --no-open)
      open_browser=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Error: unknown argument: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

latest_json="$json_path"
if [[ -z "$latest_json" ]]; then
  latest_json="$(meeting_latest_transcript "$meetings_root" || true)"
fi

[[ -n "$latest_json" ]] || {
  printf 'Error: no transcript run found in: %s\n' "$meetings_root" >&2
  exit 2
}
[[ -f "$latest_json" ]] || {
  printf 'Error: JSON transcript does not exist: %s\n' "$latest_json" >&2
  exit 2
}

html_path="${latest_json%.json}.html"
"${utility_root}/bin/render-transcript-html" "$latest_json" "$html_path" >/dev/null
printf 'Transcript: %s\n' "$html_path"
if [[ "$open_browser" -eq 1 ]]; then
  open "$html_path"
fi
