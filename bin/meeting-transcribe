#!/usr/bin/env bash
set -euo pipefail
umask 077

meeting_entry_assemblyai_key="${ASSEMBLYAI_API_KEY:-}"
unset ASSEMBLYAI_API_KEY

script_source="${BASH_SOURCE[0]}"
while [[ -L "$script_source" ]]; do
  script_dir="$(cd "$(dirname "$script_source")" && pwd)"
  script_source="$(readlink "$script_source")"
  [[ "$script_source" = /* ]] || script_source="${script_dir}/${script_source}"
done
utility_root="$(cd "$(dirname "$script_source")/.." && pwd)"
source "${utility_root}/lib/config.sh"
source "${utility_root}/lib/format.sh"
meetings_root="$(meeting_data_root)"
open_bin="${MEETING_TRANSCRIBER_OPEN_BIN:-/usr/bin/open}"
speakers=""
skip_names=0
open_transcript=1
input=""

usage() {
  printf '%s\n' \
    'Usage: meeting transcribe [INPUT] [--speakers N] [--skip-names] [--no-open]' \
    '' \
    'Transcribes INPUT, or the newest completed recording when INPUT is omitted.' \
    'The recording is uploaded to AssemblyAI, transcribed with speaker' \
    'diarization, and the remote copy is deleted after local files are saved.' \
    '' \
    'Options:' \
    '  --speakers N   Expected speaker count (omit to let AssemblyAI estimate)' \
    '  --skip-names   Keep anonymous speaker labels' \
    '  --no-open      Do not open the finished HTML transcript' \
    '  -h, --help     Show this help'
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

migration_error() {
  printf '%s\n' "$1" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --speakers)
      [[ $# -ge 2 ]] || fail '--speakers requires a positive integer'
      speakers="$2"
      shift 2
      ;;
    --skip-names)
      skip_names=1
      shift
      ;;
    --no-open)
      open_transcript=0
      shift
      ;;
    --local|--backend|--model|--hotwords|--no-diarize)
      migration_error 'Local transcription was removed; run `meeting transcribe` to use AssemblyAI.'
      ;;
    --no-copy)
      migration_error '`--no-copy` was removed; the $meeting prompt is now printed, never copied.'
      ;;
    --meetings-root|--recordings-root)
      migration_error "\`$1\` was removed; recordings are found under the private meeting folder."
      ;;
    --output-root)
      migration_error '`--output-root` was removed; transcript runs always live inside the meeting bundle.'
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      fail "unknown option: $1"
      ;;
    *)
      [[ -z "$input" ]] || fail 'provide at most one input file'
      input="$1"
      shift
      ;;
  esac
done

[[ -z "$speakers" || "$speakers" =~ ^[1-9][0-9]*$ ]] || fail '--speakers requires a positive integer'

ui_title

if [[ -z "$input" ]]; then
  input="$(meeting_latest_recording "$meetings_root" || true)"
  if [[ -z "$input" ]]; then
    ui_heading 'No completed recording found'
    ui_row 'Searched' "$(ui_display_path "$meetings_root")"
    ui_heading 'Next'
    ui_line 'meeting record'
    exit 2
  fi
  if [[ -t 0 ]]; then
    ui_heading 'Latest recording'
    ui_row 'Recording' "$(ui_display_path "$input")"
    printf '\nTranscribe this recording? [Y/n] ' >&2
    read -r selection_reply || selection_reply='n'
    case "${selection_reply:-y}" in
      y|Y|yes|YES) ;;
      *) ui_text 'Cancelled.'; exit 0 ;;
    esac
  fi
  output_root="$(dirname "$input")/transcripts"
else
  [[ -f "$input" && -r "$input" ]] || fail "input is not a readable file: $input"
  input="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
  mkdir -p "$meetings_root"
  meetings_root="$(cd "$meetings_root" && pwd)"
  input_name="$(basename "$input")"
  input_parent="$(dirname "$input")"
  if [[ ( "$input_name" == recording || "$input_name" == recording.* ) \
    && "$input_name" != recording.partial.* \
    && ! -L "$input" \
    && "$(dirname "$input_parent")" == "$meetings_root" ]]; then
    output_root="$(dirname "$input")/transcripts"
  else
    source_stem="${input_name%.*}"
    source_extension=""
    if [[ "$input_name" == *.* ]]; then
      source_extension=".${input_name##*.}"
    fi
    source_slug="$(printf '%s' "$source_stem" | LC_ALL=C sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+//; s/-+$//')"
    [[ -n "$source_slug" ]] || source_slug="meeting"
    if [[ -n "${MEETING_TRANSCRIBER_BUNDLE_ID:-}" ]]; then
      [[ "$MEETING_TRANSCRIBER_BUNDLE_ID" =~ ^[A-Za-z0-9._-]+$ ]] \
        || fail 'MEETING_TRANSCRIBER_BUNDLE_ID contains invalid characters'
      import_stamp="$MEETING_TRANSCRIBER_BUNDLE_ID"
    else
      import_stamp="$(date '+%Y%m%d-%H%M%S')"
    fi
    bundle_dir="${meetings_root}/${import_stamp}-${source_slug}"
    [[ ! -e "$bundle_dir" ]] || fail "dated meeting bundle already exists: $bundle_dir"
    mkdir "$bundle_dir"
    imported_recording="${bundle_dir}/recording${source_extension}"
    cp "$input" "$imported_recording"
    chmod 600 "$imported_recording"
    input="$imported_recording"
    output_root="${bundle_dir}/transcripts"
    ui_row 'Imported' "$(ui_display_path "$input")"
  fi
fi

ui_heading 'Transcribing'
ui_row 'Recording' "$(ui_display_path "$input")"
ui_row 'Service' 'AssemblyAI'
ui_row 'Privacy' 'Audio is uploaded, then remotely deleted after local files are saved'
if [[ -n "$speakers" ]]; then
  ui_row 'Speakers' "expecting ${speakers}"
else
  ui_row 'Speakers' 'estimating automatically'
fi
printf '\n' >&2

result_file="$(mktemp "${TMPDIR:-/tmp}/meeting-transcribe.XXXXXX")"
cleanup_temp() {
  rm -f "$result_file"
}
trap cleanup_temp EXIT

run_command=("${utility_root}/bin/transcribe-meeting")
if [[ -n "$speakers" ]]; then
  run_command+=(--speakers "$speakers")
fi
run_command+=("$input" "$output_root")

# The credential reaches only the provider run; every later child is spawned
# without it.
assemblyai_override="${meeting_inherited_assemblyai_key:-}"

set +e
if [[ -n "$assemblyai_override" ]]; then
  ASSEMBLYAI_API_KEY="$assemblyai_override" \
    MEETING_TRANSCRIBER_RESULT_FILE="$result_file" \
    "${run_command[@]}" >/dev/null
else
  MEETING_TRANSCRIBER_RESULT_FILE="$result_file" \
    "${run_command[@]}" >/dev/null
fi
run_status=$?
set -e
unset assemblyai_override

if [[ "$run_status" -ne 0 && "$run_status" -ne 3 ]]; then
  exit "$run_status"
fi

output_dir="$(sed -n '1p' "$result_file")"
[[ -n "$output_dir" && -d "$output_dir" ]] || fail 'transcription completed without reporting its run directory'
output_dir="$(cd "$output_dir" && pwd)"
json_path="${output_dir}/transcript.json"
markdown_path="${output_dir}/transcript.md"
html_path="${output_dir}/transcript.html"
[[ -f "$json_path" ]] || fail "canonical transcript JSON is missing: $json_path"

if [[ "$run_status" -eq 3 ]]; then
  meeting_notify 'Transcript saved; cleanup required'
  printf '%s\n' "$json_path"
  exit 3
fi

if [[ -t 0 && "$skip_names" -eq 0 ]]; then
  printf 'Name the detected speakers now? [Y/n] ' >&2
  read -r name_reply || name_reply='n'
  case "${name_reply:-y}" in
    y|Y|yes|YES)
      "${utility_root}/bin/meeting-speakers" "$json_path" --no-open \
        || ui_text 'Speaker naming did not finish; run meeting speakers later.'
      ;;
    *)
      ui_text 'Keeping anonymous speaker labels. Run meeting speakers later to add names.'
      ;;
  esac
fi

ui_heading 'Transcript ready'
ui_row 'Read' "$(ui_display_path "$html_path")"
ui_row 'Agent' "$(ui_display_path "$markdown_path")"
ui_row 'Data' "$(ui_display_path "$json_path")"
ui_heading 'Next'
ui_next 'meeting speakers' 'Name or correct speakers'
ui_next 'meeting open' 'Reopen the latest transcript'
printf '\nUse $meeting to digest: %s\n' "$markdown_path" >&2

if [[ -t 0 && "$open_transcript" -eq 1 ]]; then
  "$open_bin" "$html_path" || ui_text "Could not open the transcript: $html_path"
fi

meeting_notify 'Transcript ready'
printf '%s\n' "$json_path"
