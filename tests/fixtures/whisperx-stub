#!/usr/bin/env bash
set -euo pipefail

: "${STUB_ARGV:?}"
printf '%s\n' "$@" > "$STUB_ARGV"

input="$1"
shift
output_dir=""
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--output_dir" && $# -ge 2 ]]; then
    output_dir="$2"
    shift 2
  else
    shift
  fi
done
[[ -n "$output_dir" ]] || { printf 'stub: missing --output_dir\n' >&2; exit 2; }

stem="$(basename "$input")"
stem="${stem%.*}"
printf '%s' \
  '{"language":"en","segments":[{"speaker":"SPEAKER_00","start":0,"end":1,"text":"interface smoke"}]}' \
  > "${output_dir}/${stem}.json"
printf '[SPEAKER_00]: interface smoke\n' > "${output_dir}/${stem}.txt"
printf '1\n00:00:00,000 --> 00:00:01,000\n[SPEAKER_00]: interface smoke\n' \
  > "${output_dir}/${stem}.srt"
printf 'WEBVTT\n\n00:00.000 --> 00:01.000\n[SPEAKER_00]: interface smoke\n' \
  > "${output_dir}/${stem}.vtt"
printf 'start\tend\ttext\n0\t1000\tinterface smoke\n' > "${output_dir}/${stem}.tsv"
