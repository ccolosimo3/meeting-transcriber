#!/usr/bin/env bash
set -euo pipefail
umask 077
: "${STUB_ASSEMBLYAI_ARGV:?}" "${STUB_ASSEMBLYAI_ENV:?}"
printf '%s\n' "$@" > "$STUB_ASSEMBLYAI_ARGV"
if [[ -n "${ASSEMBLYAI_API_KEY:-}" ]]; then
  printf 'present\n' > "$STUB_ASSEMBLYAI_ENV"
else
  printf 'absent\n' > "$STUB_ASSEMBLYAI_ENV"
fi
output_dir=""
output_name=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-dir) output_dir="$2"; shift 2 ;;
    --output-name) output_name="$2"; shift 2 ;;
    *) shift ;;
  esac
done
: "${output_dir:?}" "${output_name:?}"
printf '%s' '{"language":"en","text":"Interface smoke. Reply.","segments":[{"id":0,"start":0,"end":1,"text":"Interface smoke.","speaker":"SPEAKER_00","words":[{"word":"Interface","start":0,"end":0.5,"probability":0.99,"speaker":"SPEAKER_00"}]},{"id":1,"start":1.2,"end":2,"text":"Reply.","speaker":"SPEAKER_01","words":[{"word":"Reply.","start":1.2,"end":2,"probability":0.97,"speaker":"SPEAKER_01"}]}],"speaker_names":{}}' \
  > "${output_dir}/${output_name}.json"
printf '%s\n' '# Interface smoke' '' 'SPEAKER_00: Interface smoke.' \
  > "${output_dir}/${output_name}.md"
printf '%s\n' '<!doctype html><html><body>SPEAKER_00 Interface smoke</body></html>' \
  > "${output_dir}/${output_name}.html"
if [[ "${STUB_ASSEMBLYAI_EXIT3:-0}" == "1" ]]; then
  printf '%s' '{"provider":"assemblyai","requested_model":"universal-3-5-pro","used_model":"universal-3-5-pro","transcript_id":"job-smoke","state":"published","provider_status":"completed","timestamps":{"created_at":"2026-08-26T10:00:00Z","submitted_at":"2026-08-26T10:01:00Z","completed_at":"2026-08-26T10:02:00Z","published_at":"2026-08-26T10:02:01Z"}}' \
    > "${output_dir}/.assemblyai.json"
  printf '%s\n' "${output_dir}/${output_name}.json"
  exit 3
fi
printf '%s' '{"provider":"assemblyai","requested_model":"universal-3-5-pro","used_model":"universal-3-5-pro","transcript_id":"job-smoke","state":"published","provider_status":"completed","timestamps":{"created_at":"2026-08-26T10:00:00Z","submitted_at":"2026-08-26T10:01:00Z","completed_at":"2026-08-26T10:02:00Z","published_at":"2026-08-26T10:02:01Z"},"deletion":{"confirmed":true,"confirmed_at":"2026-08-26T10:02:02Z"}}' \
  > "${output_dir}/.assemblyai.json"
printf '%s\n' "${output_dir}/${output_name}.json"
